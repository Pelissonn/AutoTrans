# Copie este arquivo para backend/.env e preencha os valores.
# O arquivo .env NÃO vai para o repositório (está no .gitignore).

FLASK_DEBUG=True

# Chave que assina os tokens de login. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Banco de dados. Sem esta linha, o projeto usa SQLite em backend/instance/autotrans.db.
# Para MySQL, rode database/create_database.sql e descomente:
# DATABASE_URL=mysql+pymysql://root:sua_senha@localhost:3306/autotrans_db

# Integração com IA (explicação das questões). Gere a chave em https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
